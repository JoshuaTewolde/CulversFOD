{
  "manifest_version": 3,
  "name": "Culver's FOD",
  "version": "1.0",
  "description": "View your Culver's Flavor of the Day. Yum.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.culvers.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png"
    }
  },
  "options_page": "options.html"
}